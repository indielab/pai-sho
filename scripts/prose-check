#!/usr/bin/env python3
"""Fail on the prose tells listed in AGENTS.md.

Catches what is mechanically detectable. It cannot catch invented detail or
rhetorical framing, so it is a floor, not a substitute for reading.

Usage: scripts/prose-check [files...]        (defaults to tracked markdown)
"""
import re
import subprocess
import sys

FENCE = re.compile(r"```.*?```", re.S)
HTML_BLOCK = re.compile(r"<(p|div|h1|table)\b.*?</\1>", re.S)
HTML = re.compile(r"<[^>]+>")

# Not gated:
#   docs/adr/            an append-only record of decisions as they were made;
#                        rewriting them for style would destroy their purpose
#   tech-writer inputs   briefs are fact lists, and PROMPT.md quotes bad prose
#                        on purpose as examples. Only accepted.md is gated.
SKIP = (
    "docs/adr/",
    "docs/tech-writer/PROMPT.md",
    "docs/tech-writer/README.md",
)
SKIP_NAMES = ("brief.md",)
LINK = re.compile(r"\[([^\]]*)\]\([^)]*\)")
TABLE = re.compile(r"^\s*\|")


def prose(text):
    """Strip code fences, HTML, table rows; keep link text only."""
    text = FENCE.sub("", text)
    text = HTML_BLOCK.sub("", text)
    text = HTML.sub("", text)
    text = LINK.sub(r"\1", text)
    return "\n".join(l for l in text.split("\n") if not TABLE.match(l))


def paragraphs(text):
    for block in prose(text).split("\n\n"):
        block = " ".join(block.split())
        if block and not block.startswith(("#", "-", "*", ">", "|")):
            yield block


def sentences(para):
    return [s for s in re.split(r"(?<=[.:!?])\s+", para) if s]


def check(path):
    text = open(path, encoding="utf-8").read()
    out = []

    for m in re.finditer(r"[^\x00-\x7f]", text):
        line = text[: m.start()].count("\n") + 1
        out.append((line, "non-ascii", repr(m.group(0))))

    for para in paragraphs(text):
        sents = sentences(para)

        for s in sents:
            if re.search(r",\s+\w+(ing|ed)\b[^.]*$", s):
                out.append((0, "participial coda", s[:70]))
            # A rhetorical triad is three parallel *clauses*, not a list of
            # nouns. Require each segment to carry some weight.
            m = re.search(r"\b(\w[\w\s`'\-]{6,40}), (\w[\w\s`'\-]{6,40}), and (\w[\w\s`'\-]{6,40})\b", s)
            if m and all(len(g.split()) >= 3 for g in m.groups()):
                out.append((0, "rule of three", s[:70]))
            # Semicolon triads: "A, since X; B, since Y; and C" is the same
            # rhetorical shape, and commas alone will not catch it.
            if s.count(";") >= 2 and re.search(r";\s+and\b", s):
                out.append((0, "rule of three (semicolons)", s[:70]))
            if re.search(
                r"\b(two halves|three things|four things|what differs|"
                r"the difference is|worth stating|here is (why|what)|"
                r"the (real|actual) \w+ is)\b",
                s,
                re.I,
            ):
                out.append((0, "announces structure", s[:70]))

        # Cadence: a paragraph that descends to a short landing beat.
        if len(sents) >= 3:
            last = sents[-1]
            exempt = (
                last.startswith(("See ", "See:"))          # cross-reference
                or last.startswith("(")                     # parenthetical aside
                or last.rstrip(".").endswith(":")           # lead-in to a block
                or re.fullmatch(r"[`\w,.\- ]*", last) and last.count("`") >= 4
            )                                               # bare list of names
            lens = [len(x.split()) for x in sents]
            if not exempt and lens[-1] <= 6 and lens[-1] < min(lens[:-1]):
                out.append((0, "descends to a landing beat", last[:70]))

    return out


def main(argv):
    files = argv[1:]
    if not files:
        files = subprocess.run(
            ["git", "ls-files", "*.md"], capture_output=True, text=True
        ).stdout.split()
        files = [
            f
            for f in files
            if not f.startswith(SKIP) and not f.endswith(SKIP_NAMES)
        ]

    total = 0
    for f in files:
        for line, kind, detail in check(f):
            where = f"{f}:{line}" if line else f
            print(f"{where}: {kind}: {detail}")
            total += 1

    if total:
        print(f"\n{total} finding(s). See AGENTS.md, Writing style.")
    return 1 if total else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
